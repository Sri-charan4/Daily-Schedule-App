<!--
  Status-bar icon. Android throws away the colours here and keeps only the
  alpha, so this is a solid white silhouette rather than the line-drawn
  launcher leaf — an outline at 24dp turns to mush in the status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Blade -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1.8 C15,5 18.5,9 18.5,12 C18.5,15 15.6,17.6 12,18.6 C8.4,17.6 5.5,15 5.5,12 C5.5,9 9,5 12,1.8 Z" />

    <!-- Stem, carried down past the blade -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.1,15 L12.9,15 L12.9,22.2 L11.1,22.2 Z" />
</vector>
