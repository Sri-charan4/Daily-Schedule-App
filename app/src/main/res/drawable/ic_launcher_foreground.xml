<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a single line-drawn leaf.

  The 108dp viewport has a 72dp safe zone in the middle (18..90 on both
  axes) — anything outside that can be cropped away by whatever mask the
  launcher applies, so the whole drawing is kept inside it. The leaf runs
  y=23 (tip) to y=86 (end of the stem), centred at 54.5.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Blade. Two mirrored pairs of curves: tip to widest point, then down
         to the base where the stem takes over. -->
    <path
        android:pathData="M54,23 C62,33 70,45 70,55 C70,65 63,72 54,76 C45,72 38,65 38,55 C38,45 46,33 54,23 Z"
        android:strokeColor="#1C4034"
        android:strokeWidth="3.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- Midrib, continuing past the blade to become the stem. -->
    <path
        android:pathData="M54,29 L54,86"
        android:strokeColor="#1C4034"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <!-- Three pairs of veins, angling up and out, shortening toward the tip.
         They stop short of the outline rather than meeting it. -->
    <path
        android:pathData="M54,62 L63,54 M54,62 L45,54"
        android:strokeColor="#1C4034"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,53 L63,45 M54,53 L45,45"
        android:strokeColor="#1C4034"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,44.5 L60,38.5 M54,44.5 L48,38.5"
        android:strokeColor="#1C4034"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
</vector>
