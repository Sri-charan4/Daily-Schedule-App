# Copy this file to keystore.properties and fill it in. That file is
# gitignored -- it holds passwords and must never be committed.
#
# Create the key itself first (once, ever):
#
#   keytool -genkeypair -v \
#     -keystore ~/keystores/dailyschedule-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias dailyschedule
#
# Keep that .jks file backed up somewhere safe. If it is lost, no future
# build can update an app already installed from it -- every user would
# have to uninstall and lose their data.

storeFile=/home/sri/keystores/dailyschedule-release.jks
storePassword=your-keystore-password
keyAlias=dailyschedule
keyPassword=your-key-password
